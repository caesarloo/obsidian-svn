{
  "name": "obsidian-svn",
  "version": "1.1.13",
  "private": true,
  "description": "Vault SVN plugin",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "release:publish": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.3",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "jest": "^30.2.0",
    "obsidian": "^1.8.7",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "iconv-lite": "^0.7.0"
  }
}
